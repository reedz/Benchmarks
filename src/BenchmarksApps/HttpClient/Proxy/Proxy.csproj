<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseIoUringTransport)' == 'true'">
    <DefineConstants>$(DefineConstants);IOURING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Crank.EventSources" Version="0.1.0-alpha.20501.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseIoUringTransport)' == 'true'">
    <PackageReference Include="Kestrel.Transport.IoUring" Version="*" />
    <PackageReference Include="HttpClient.IoUring" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="testCert.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
